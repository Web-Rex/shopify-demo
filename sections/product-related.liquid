<div class="pd-related-wrapper">
  <h2 class="pd-related-title">{{ section.settings.heading }}</h2>
  <div class="pd-related-grid">
    {% for related_product in collections.all.products limit: 4 %}
      {% unless related_product.id == product.id %}
        <a href="{{ related_product.url }}" class="pd-rel-card">
          <img
            src="{{ related_product.featured_image | image_url: width: 500 }}"
            alt="{{ related_product.featured_image.alt | default: related_product.title }}"
            class="pd-rel-img"
          >
          <div class="pd-rel-info">
            <h3 class="pd-rel-name">{{ related_product.title }}</h3>
            <div class="pd-rel-price">{{ related_product.price | money }}</div>
          </div>
        </a>
      {% endunless %}
    {%- endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You Might Also Like"
    }
  ]
}
{% endschema %}

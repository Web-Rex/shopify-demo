<header class="hero">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subheading }}</p>
  <a href="{{ section.settings.button_link }}" class="btn-primary">{{ section.settings.button_label }}</a>
</header>

{% schema %}
{
  "name": "Home Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Premium Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated collection of high-quality electronics, accessories, and everyday essentials."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "default": {
    "settings": {
      "heading": "Discover Premium Products",
      "subheading": "Explore our curated collection of high-quality electronics, accessories, and everyday essentials.",
      "button_label": "Shop Now",
      "button_link": "/collections/all"
    }
  }
}
{% endschema %}

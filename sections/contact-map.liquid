<section class="ct-map-section">
  <iframe
    class="ct-map-frame"
    src="https://www.google.com/maps?q={{ section.settings.address | url_encode }}&output=embed"
    width="100%"
    height="450"
    style="border:0;"
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-upgrade"
  ></iframe>
</section>

{% schema %}
{
  "name": "Contact Map",
  "settings": [
    {
      "type": "text",
      "id": "address",
      "label": "Location",
      "default": "1 Market St, San Francisco, CA 94105"
    }
  ]
}
{% endschema %}
